# ============================================================================
# MD SELIM (https://mdselim.com) — Production Environment Configuration
# Copy this file to .env for local development or configure in your hosting
# dashboard (Cloudflare Pages / Cloud Run / Node.js server environment).
# Never commit actual secret values to version control.
# ============================================================================

# 1. Server-Side AI Assistant Key (Required for live Gemini responses on /api/chat)
# Note: Never prefix with VITE_ so this secret stays strictly server-side.
# If omitted, /api/chat automatically uses the built-in verified knowledge-base fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Canonical Application URL
# Used by server-side security checks and reference links.
APP_URL="https://mdselim.com"

# 3. Google Search Console Verification Token (Optional)
# Populates <meta name="google-site-verification" content="..." /> in the document head.
# You may also verify domain ownership via DNS TXT record at the root (@) of mdselim.com.
VITE_GOOGLE_SITE_VERIFICATION="OmCZTyfne7XN_LTu8t-GoXj4lxtHNCGRuG5nDn8tEnU"

# 4. Contact Form & Preliminary Brief Webhook URL (Optional — Server-Side Only)
# When set, validated submissions to POST /api/contact and POST /api/chat/preliminary-brief
# are forwarded as JSON to this webhook endpoint (e.g. Formspree, Resend, Make, Slack, CRM).
# Do not prefix with VITE_ to keep webhook URLs private on the server.
CONTACT_WEBHOOK_URL=""

# 5. Cloudflare Web Analytics Beacon Token (Optional — Privacy-First Analytics)
# Leave empty if Cloudflare Pages automatic Web Analytics injection is enabled in the
# Cloudflare dashboard, or provide your site token for standalone Node/Cloud Run hosting.
VITE_CF_BEACON_TOKEN=""
